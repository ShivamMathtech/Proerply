APP_ENV=development
DATABASE_URL=sqlite:///./data/proerply.db
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_DAYS=7
# Local demo accounts only. Production refuses SEED_DEMO_USERS=true.
SEED_DEMO_USERS=true
SEED_PASSWORD=DemoPass123!
# SMTP is optional locally; otherwise recovery codes go to data/dev-mailbox/.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=learning@proerply.example
SMTP_STARTTLS=true
# Real/test provider keys stay only on the backend.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ICE_SERVERS_JSON=[]
TURN_URL=
TURN_SECRET=
